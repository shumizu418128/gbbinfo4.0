{
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "scripts": {
    "sync:locales": "tsx scripts/sync/inlang-locales.ts",
    "sync:build-cache": "tsx scripts/sync/build-cache.ts",
    "sync:search-catalog": "tsx scripts/sync/search-catalog.ts",
    "sync:tavily:upload": "tsx scripts/sync/tavily-db.ts",
    "sync:tavily:download": "tsx scripts/sync/tavily-cache.ts",
    "build": "npm run sync:locales && npm run sync:build-cache && npm run sync:search-catalog && astro build",
    "dev": "npm run sync:locales && npm run sync:build-cache -- --skip && astro dev",
    "preview": "astro preview",
    "start": "astro preview",
    "typecheck": "astro check",
    "assets:prepare": "node scripts/deploy/prepare-pages-dir.mjs",
    "assets:dev": "npm run dev:public-only --prefix cloudflare",
    "assets:dev:with-astro": "npm run assets:prepare && npm run dev --prefix cloudflare",
    "assets:deploy": "npm run assets:prepare && npm run deploy --prefix cloudflare",
    "r2:convert-webp": "tsx scripts/r2/convert-to-webp.ts",
    "r2:upload-avatar": "tsx scripts/r2/upload-avatar.ts",
    "backup:db": "tsx scripts/backup-db-csv.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.11",
    "@astrojs/react": "^6.0.0",
    "@astrojs/sitemap": "^3.7.4",
    "@emnapi/core": "^1.11.2",
    "@emnapi/runtime": "^1.11.2",
    "@tavily/core": "^0.7.14",
    "astro": "^7.4.1",
    "drizzle-orm": "^0.45.4",
    "lodash": "^4.18.1",
    "maplibre-gl": "^6.15.0",
    "postgres": "^3.4.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@inlang/paraglide-js": "^2.29.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/lodash": "^4.17.26",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  }
}
