---
import type { SupportedLanguage } from "~/constants/languageLabels";

interface Props {
  locale: SupportedLanguage;
  latestYear: number;
}

const { locale, latestYear } = Astro.props;
const href = `/${locale}/${latestYear}/top`;
const buttonClass =
  "flex min-h-16 cursor-pointer items-center justify-center border border-(--button-border-color) bg-(--hamburger-menu-background-color) px-4 py-2 transition-colors duration-150 hover:bg-(--gbb-color)";
---

<div id="latest-year-prompt" class="fixed bottom-32 left-8 z-50">
  <a href={href} class={buttonClass}>
    <span class="text-xs font-bold text-white">{latestYear}</span>
  </a>
</div>
