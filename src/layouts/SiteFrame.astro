---
import Layout from "./Layout.astro";
import HeaderMenu from "~/components/HeaderMenu.astro";
import HamburgerMenu from "~/components/HamburgerMenu.astro";
import { HeroImage } from "~/components/HeroImage";
import FooterMenu from "~/components/FooterMenu.astro";
import LatestYearPrompt from "~/components/LatestYearPrompt.astro";
import type { SupportedLanguage } from "~/constants/languageLabels";
import type { YearWithCountry } from "~/db/year";

interface Props {
  locale: SupportedLanguage;
  pageTitle: string;
  yearWithCountry?: YearWithCountry;
  years: number[];
  latestYearWithCountry: YearWithCountry;
  heroSubtitle?: string;
  heroHeading?: string;
}

const {
  locale,
  pageTitle,
  yearWithCountry,
  years,
  latestYearWithCountry,
  heroSubtitle,
  heroHeading,
} = Astro.props;

const currentPath = Astro.url.pathname;
const headerYear = yearWithCountry?.year ?? latestYearWithCountry.year;
const isPastYearPage =
  yearWithCountry != null &&
  yearWithCountry.year < latestYearWithCountry.year;
const startsAtMs = yearWithCountry?.startsAt
  ? new Date(yearWithCountry.startsAt).getTime()
  : NaN;
const heroCountdownTargetIso =
  Number.isFinite(startsAtMs) && startsAtMs > Date.now()
    ? new Date(startsAtMs).toISOString()
    : null;
---

<Layout locale={locale} pageTitle={pageTitle}>
  <HeaderMenu
    lang={locale}
    currentPath={currentPath}
    year={headerYear}
    years={years}
  />
  <HeroImage yearWithCountry={yearWithCountry} heroSubtitle={heroSubtitle} heroHeading={heroHeading} />
  {
    heroCountdownTargetIso && (
      <script define:vars={{ heroCountdownTargetIso }}>
        const root = document.getElementById("hero-gbb-countdown-root");
        const valueEl = document.getElementById("hero-gbb-countdown-value");

        if (root instanceof HTMLElement && valueEl instanceof HTMLElement) {
          const formatCountdown = (targetMs) => {
            const totalMs = Math.max(0, targetMs - Date.now());
            const secondsTotal = Math.floor(totalMs / 1000);
            const days = Math.floor(secondsTotal / 86400);
            const hours = Math.floor((secondsTotal % 86400) / 3600);
            const minutes = Math.floor((secondsTotal % 3600) / 60);
            const seconds = secondsTotal % 60;
            const dd = String(days).padStart(2, "0");
            const hh = String(hours).padStart(2, "0");
            const mm = String(minutes).padStart(2, "0");
            const ss = String(seconds).padStart(2, "0");
            return {
              totalMs,
              text: `${dd}d ${hh}:${mm}:${ss}`,
            };
          };

          const target = Date.parse(heroCountdownTargetIso);
          if (!Number.isNaN(target)) {
            const tick = () => {
              const next = formatCountdown(target);
              if (next.totalMs === 0) {
                root.classList.add("hidden");
                return;
              }

              valueEl.textContent = next.text;
              root.classList.remove("hidden");

              const delay = 1000 - (Date.now() % 1000);
              window.setTimeout(tick, delay);
            };

            tick();
          }
        }
      </script>
    )
  }
  <slot />
  <FooterMenu locale={locale} latestYearWithCountry={latestYearWithCountry} />
  <HamburgerMenu
    lang={locale}
    currentPath={currentPath}
    year={headerYear}
    years={years}
  />
  {
    isPastYearPage && (
      <LatestYearPrompt
        locale={locale}
        latestYear={latestYearWithCountry.year}
      />
    )
  }
</Layout>
