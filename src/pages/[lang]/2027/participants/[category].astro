---
import SiteFrame from "~/layouts/SiteFrame.astro";
import { ParticipantsContent } from "~/views/2027/ParticipantsContent";
import ParticipantWorldMap from "~/components/ParticipantWorldMap.astro";
import { buildWorldMapMarkers } from "~/util/worldMapMarkers";
import { GBB_2027_YEAR, getGbb2027CommonData } from "~/util/gbb2027";
import { findParticipants } from "~/db/participant";
import { findCategoriesByIds } from "~/db/category";
import { categorySlug } from "~/util/category";
import { buildAvatarImageUrlMap } from "~/util/participantAvatar";
import { locales } from "@paraglide/runtime.js";
import * as m from "@paraglide/messages.js";

// Astro の静的パス生成は export async function getStaticPaths で公開する。
export async function getStaticPaths() {
  const common = await getGbb2027CommonData();
  const validCategories = await findCategoriesByIds(
    common.yearWithCountry.categories ?? [],
  );
  const categoryNames = validCategories.map((category) => category.name);
  const paths = [];

  for (const category of validCategories) {
    const participants = await findParticipants(GBB_2027_YEAR, category.id, null);
    const avatarImageUrls = await buildAvatarImageUrlMap(
      participants.map((participant) => participant.name),
    );
    for (const locale of locales) {
      paths.push({
        params: { lang: locale, category: categorySlug(category.name) },
        props: {
          locale,
          participants,
          selectedCategory: category,
          categoryNames,
          avatarImageUrls,
          ...common,
        },
      });
    }
  }
  return paths;
}

const {
  locale,
  participants,
  selectedCategory,
  categoryNames,
  avatarImageUrls,
  yearWithCountry,
  years,
  latestYearWithCountry,
} = Astro.props;

const mapMarkers = buildWorldMapMarkers(participants, locale);
const heroSubtitle = m.participants();
const pageTitle = `GBB ${yearWithCountry.year} ${heroSubtitle}`;
---

<SiteFrame
  locale={locale}
  pageTitle={pageTitle}
  heroSubtitle={heroSubtitle}
  yearWithCountry={yearWithCountry}
  years={years}
  latestYearWithCountry={latestYearWithCountry}
>
  <ParticipantsContent
    participants={participants}
    locale={locale}
    selectedCategory={selectedCategory}
    categoryNames={categoryNames}
    avatarImageUrls={avatarImageUrls}
  />
  <ParticipantWorldMap markers={mapMarkers} locale={locale} />
</SiteFrame>
