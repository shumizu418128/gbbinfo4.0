---
import SiteFrame from "~/layouts/SiteFrame.astro";
import { ParticipantsPendingContent } from "~/views/2027/ParticipantsPendingContent";
import { getCommonYearData } from "~/util/staticPaths";
import { findCategoriesByIds } from "~/db/category";
import { categorySlug } from "~/util/category";
import { locales } from "@paraglide/runtime.js";
import * as m from "@paraglide/messages.js";

// Astro の静的パス生成は export async function getStaticPaths で公開する。
export async function getStaticPaths() {
  const YEAR = 2027;
  const common = await getCommonYearData(YEAR);
  const validCategories = await findCategoriesByIds(
    common.yearWithCountry.categories ?? [],
  );

  if (validCategories.length === 0) {
    return locales.map((locale) => ({
      params: { lang: locale },
      props: { locale, target: null, ...common },
    }));
  }

  const firstSlug = categorySlug(validCategories[0].name);
  return locales.map((locale) => ({
    params: { lang: locale },
    props: {
      locale,
      target: `/${locale}/${YEAR}/participants/${firstSlug}`,
      ...common,
    },
  }));
}

const { locale, target, yearWithCountry, years, latestYearWithCountry } =
  Astro.props;

if (target) {
  return Astro.redirect(target);
}

const heroSubtitle = m.participants();
const pageTitle = `GBB ${yearWithCountry.year} ${heroSubtitle}`;
---

<SiteFrame
  locale={locale}
  pageTitle={pageTitle}
  heroSubtitle={heroSubtitle}
  yearWithCountry={yearWithCountry}
  years={years}
  latestYearWithCountry={latestYearWithCountry}
>
  <ParticipantsPendingContent />
</SiteFrame>
