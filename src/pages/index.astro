---
import FaviconLink from "~/components/FaviconLink.astro";
import {
  baseLocale,
  supportedLanguages,
  ogLocales,
} from "~/constants/languageLabels";
import { createMeta } from "~/util/meta";
import { envCheck } from "~/util/dev";
import {
  SITE_NAME,
  THEME_COLOR,
  toAbsoluteUrl,
  buildRootHreflangLinks,
  defaultOgImageUrl,
} from "~/util/seo";
import { loadBuildCache } from "~/db/buildCache.js";
import { setLocale } from "../../paraglide/runtime.js";
// ルートパス: 言語を自動判定し、現在の開催年のトップへリダイレクトする。
// SSG ではサーバー側で言語判定できないため、クライアントで navigator.language を見る。
// 開催年は壁時計ではなくビルドスナップショット（降順先頭）を正とする。
const resolveEventYear = (): number => {
  const store = loadBuildCache();
  if (store && store.allYears.length > 0) {
    return store.allYears[0];
  }
  return new Date().getFullYear();
};
const year = resolveEventYear();
const fallback = `/${baseLocale}/${year}/top`;
const env = envCheck();
setLocale(baseLocale, { reload: false });
const meta = createMeta(env, `GBB ${year}`);
const metaTitle = (meta[0] as { title: string }).title;
const description = (meta[1] as { content: string }).content;
const showDevBanner = Boolean(env && env !== "production");
const canonicalUrl = toAbsoluteUrl(Astro.site, fallback);
const hreflangLinks = buildRootHreflangLinks(Astro.site, year);
const ogImage = defaultOgImageUrl();
const ogLocale = ogLocales[baseLocale];
---

<!doctype html>
<html lang={baseLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={THEME_COLOR} />
    {
      showDevBanner && (
        <meta name="robots" content="noindex, nofollow" />
      )
    }
    <FaviconLink />
    <title>{metaTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {
      hreflangLinks.map(({ hreflang, href }) => (
        <link rel="alternate" hreflang={hreflang} href={href} />
      ))
    }
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta http-equiv="refresh" content={`0; url=${fallback}`} />
    <script is:inline define:vars={{ year, fallback, supportedLanguages, baseLocale }}>
      const nav = (navigator.language || baseLocale).toLowerCase();
      let locale = baseLocale;
      if (nav.startsWith("zh")) {
        // 中国語は navigator.language が "zh-cn" / "zh-tw" / "zh-hk" のような
        // BCP47 表記のため、地域から簡体字/繁体字を判定する。
        locale = nav.includes("tw") || nav.includes("hk") || nav.includes("mo")
          ? "zh_Hant_TW"
          : "zh_Hans_CN";
      } else {
        const short = nav.slice(0, 2);
        if (supportedLanguages.includes(short)) {
          locale = short;
        }
      }
      window.location.replace(
        locale === baseLocale ? fallback : `/${locale}/${year}/top`,
      );
    </script>
  </head>
  <body></body>
</html>
